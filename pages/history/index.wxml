<view class="page"><view class="row header"><view><view class="title">测试记录</view><view class="subtitle">仅本地保存，支持离线查看与顺序对比</view></view><button wx:if="{{records.length}}" class="clear" bindtap="clear">清空</button></view><view wx:if="{{!records.length}}" class="empty">还没有测试记录<br/>完成一次分析后会显示在这里</view><view wx:for="{{records}}" wx:key="id" class="card record" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="record-name">{{item.name}}</text><text class="tag">{{item.mode === 'phone' ? '手机' : '耳机'}}</text></view><view class="subtitle">{{item.createdAt}} · {{item.duration}} ms</view><view class="row stats"><text>RMS {{item.summary.rmsDb}} dBFS</text><text>主峰 {{item.summary.peakFrequency}} Hz</text></view></view></view>
