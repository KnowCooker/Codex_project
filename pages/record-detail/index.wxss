.notice { margin-top:20rpx; }.subtle { color:#47637f; background:rgba(213,231,255,.60); }.actions { display:flex; gap:16rpx; margin-top:24rpx; }.actions button { flex:1; font-size:25rpx; }.delete { margin-top:18rpx; font-size:26rpx; }
.detail-heading { align-items:flex-start; gap:16rpx; }
.record-title { min-width:0; flex:1; overflow-wrap:anywhere; }
.edit-toggle { flex-shrink:0; margin:0; padding:0 16rpx; font-size:21rpx; line-height:52rpx; color:#38516f; background:rgba(224,232,246,.78); }
.tag-list { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:16rpx; }
.detail-tag { padding:6rpx 14rpx; border-radius:999rpx; color:#087f78; background:rgba(116,222,205,.20); font-size:20rpx; }
.record-notes { margin-top:16rpx; padding:16rpx; border-radius:12rpx; color:#526782; background:rgba(237,243,250,.75); font-size:23rpx; line-height:1.6; white-space:pre-wrap; }
.editor { margin-top:20rpx; }
.editor-title { color:#263957; font-size:28rpx; font-weight:650; }
.field-label { margin-top:20rpx; margin-bottom:8rpx; color:#526782; font-size:22rpx; }
.field-input, .field-textarea { box-sizing:border-box; width:100%; padding:16rpx; border:1rpx solid rgba(123,148,184,.42); border-radius:12rpx; color:#263957; background:#f9fcff; font-size:24rpx; }
.field-textarea { min-height:150rpx; }
.editor-actions { display:flex; gap:16rpx; margin-top:22rpx; }
.editor-actions button { flex:1; margin:0; font-size:24rpx; }
