<view class="page" wx:if="{{record}}"><view class="card"><view class="title">{{record.name}}</view><view class="subtitle">{{record.createdAt}} · {{record.platform}} · {{record.model}}</view><view class="divider"/><view class="row"><text class="muted">采集模式</text><text class="value">{{record.mode === 'phone' ? '手机麦克风' : '耳机麦克风'}} · {{record.source}}</text></view><view class="divider"/><view class="row"><text class="muted">耳侧信息</text><text class="value">{{record.earSide === 'auto' ? '自动' : '用户声明' + (record.earSide === 'left' ? '左耳' : '右耳')}}{{record.earVerified ? ' · 已验证' : ' · 未验证'}}</text></view><view class="divider"/><view class="row"><text class="muted">分析参数</text><text class="value">{{record.sampleRate}} Hz · FFT {{record.fftSize}}</text></view></view>
<view class="grid"><view class="metric"><view class="metric-label">RMS</view><view class="metric-value">{{record.summary.rmsDb}} dBFS</view></view><view class="metric"><view class="metric-label">数字峰值</view><view class="metric-value">{{record.summary.peakDb}} dBFS</view></view><view class="metric"><view class="metric-label">主峰频率</view><view class="metric-value">{{record.summary.peakFrequency}} Hz</view></view><view class="metric"><view class="metric-label">时长</view><view class="metric-value">{{record.duration}} ms</view></view></view>
<view wx:if="{{!record.earVerified && record.mode === 'headset'}}" class="notice">此耳机输入未经验证；耳侧仅为用户声明，不能作为硬件路由确认。</view><view class="notice subtle">原始结果为 dBFS。尚未内置同型号可信参考配置，因此不会显示 SPL 或 dB(A)。</view><view wx:if="{{playbackMessage}}" class="notice">{{playbackMessage}}</view>
<view class="actions"><button class="secondary" bindtap="togglePlayback">{{playing ? '暂停回放' : '回放录音'}}</button><button class="secondary" bindtap="compare">选择记录对比</button></view><button class="danger delete" bindtap="remove">删除此记录</button></view>
