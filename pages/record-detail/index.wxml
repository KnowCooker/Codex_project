<view class="page" wx:if="{{record}}">
  <view class="card">
    <view class="title record-title">{{record.name}}</view>
    <view class="divider"/>
    <view class="row"><text class="muted">源数据格式</text><text class="value">{{formatLabel}} · PCM {{record.bitsPerSample}} bit · {{record.channels}} 声道</text></view>
    <view class="divider"/>
    <view class="row"><text class="muted">录音时长</text><text class="value">{{record.durationLabel}}</text></view>
    <view class="divider"/>
    <view class="row"><text class="muted">采样率</text><text class="value">{{record.wavSampleRate}} Hz</text></view>
    <view class="divider"/>
    <view class="row"><text class="muted">录音时间</text><text class="value">{{record.createdAt}}</text></view>
    <view class="divider"/>
    <view class="row"><text class="muted">录音时校准差值</text><text class="value">{{record.calibrationLabel}}</text></view>
  </view>
  <view wx:if="{{fileMessage}}" class="notice">{{fileMessage}}</view>
  <view class="actions"><button class="secondary" bindtap="compare">数据对比</button></view>
  <button class="danger delete" bindtap="remove">删除此记录</button>
</view>
