<view class="page" wx:if="{{record}}"><view class="card"><view class="row detail-heading"><view class="title record-title">{{record.name}}</view><button class="edit-toggle" bindtap="startEditing">编辑信息</button></view><view class="subtitle">{{record.createdAt}} · {{record.platform}} · {{record.model}}</view><view wx:if="{{record.tags && record.tags.length}}" class="tag-list"><text wx:for="{{record.tags}}" wx:key="*this" class="detail-tag">{{item}}</text></view><view wx:if="{{record.notes}}" class="record-notes">{{record.notes}}</view><view class="divider"/><view class="row"><text class="muted">采集模式</text><text class="value">{{record.mode === 'phone' ? '手机麦克风' : '耳机麦克风'}} · {{record.source}}</text></view><view class="divider"/><view class="row"><text class="muted">耳侧信息</text><text class="value">{{record.earSide === 'auto' ? '自动' : '用户声明' + (record.earSide === 'left' ? '左耳' : '右耳')}}{{record.earVerified ? ' · 已验证' : ' · 未验证'}}</text></view><view class="divider"/><view class="row"><text class="muted">分析参数</text><text class="value">{{record.sampleRate}} Hz · FFT {{record.fftSize}}{{record.averageSeconds ? ' · 平均 ' + record.averageSeconds + ' 秒' : ''}}</text></view><view class="divider"/><view class="row"><text class="muted">录音文件</text><text class="value">{{playbackAvailable ? 'WAV · 可回放' : 'PCM · 不可直接回放'}}</text></view></view>
<view wx:if="{{editing}}" class="card editor"><view class="editor-title">编辑记录信息</view><view class="field-label">名称</view><input class="field-input" maxlength="60" value="{{draftName}}" bindinput="setDraftName" placeholder="输入记录名称"/><view class="field-label">备注</view><textarea class="field-textarea" maxlength="500" value="{{draftNotes}}" bindinput="setDraftNotes" placeholder="记录环境、设备状态或异常现象"/><view class="field-label">标签</view><input class="field-input" maxlength="160" value="{{draftTags}}" bindinput="setDraftTags" placeholder="用逗号分隔，最多 8 个"/><view class="editor-actions"><button class="secondary" bindtap="cancelEditing">取消</button><button class="primary" bindtap="saveDetails">保存</button></view></view>
<view class="grid"><view class="metric"><view class="metric-label">RMS</view><view class="metric-value">{{record.summary.rmsDb}} dBFS</view></view><view class="metric"><view class="metric-label">数字峰值</view><view class="metric-value">{{record.summary.peakDb}} dBFS</view></view><view class="metric"><view class="metric-label">主峰频率</view><view class="metric-value">{{record.summary.peakFrequency}} Hz</view></view><view class="metric"><view class="metric-label">时长</view><view class="metric-value">{{record.duration}} ms</view></view></view>
<view wx:if="{{!record.earVerified && record.mode === 'headset'}}" class="notice">此耳机输入未经验证；耳侧仅为用户声明，不能作为硬件路由确认。</view><view class="notice subtle">原始结果为 dBFS。尚未内置同型号可信参考配置，因此不会显示 SPL 或 dB(A)。</view><view wx:if="{{playbackMessage}}" class="notice">{{playbackMessage}}</view>
<view class="actions"><button class="secondary" disabled="{{!playbackAvailable}}" bindtap="togglePlayback">{{playing ? '暂停回放' : '回放 WAV'}}</button><button class="secondary" bindtap="compare">数据对比</button></view><button class="danger delete" bindtap="remove">删除此记录</button></view>
