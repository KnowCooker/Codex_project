.recording-header { margin-bottom:24rpx; }
.swipe-row { position:relative; overflow:hidden; margin-bottom:22rpx; border-radius:20rpx; }
.recording-file { position:relative; z-index:1; box-sizing:border-box; margin-bottom:0; padding:22rpx 24rpx; border-color:rgba(123,148,184,.32); box-shadow:none; background:#f9fcff; transition:transform .16s ease; }
.recording-file.swiping { transition:none; }
.swipe-actions { position:absolute; z-index:0; top:0; right:0; bottom:0; width:240rpx; display:flex; }
.swipe-actions button { width:120rpx; height:100%; display:flex; align-items:center; justify-content:center; margin:0; padding:0 8rpx; border-radius:0; color:#fff; font-size:21rpx; line-height:1.3; text-align:center; }
.pin-action { background:#5e79a6; }
.delete-action { background:#c9566c; }
.file-title { min-width:0; display:flex; align-items:center; gap:10rpx; }
.file-name { min-width:0; color:#263957; font-size:26rpx; font-weight:650; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.pin-mark { flex-shrink:0; padding:3rpx 8rpx; border-radius:6rpx; color:#4a6592; background:rgba(209,223,246,.75); font-size:17rpx; }
.format { flex-shrink:0; padding:5rpx 12rpx; border-radius:8rpx; font-size:19rpx; }
.format.ready { color:#087f78; background:rgba(116,222,205,.24); border:1rpx solid rgba(48,165,153,.32); }
.format.legacy { color:#9b6a08; background:rgba(253,208,113,.26); border:1rpx solid rgba(190,136,29,.28); }
.file-meta { margin-top:10rpx; color:#718096; font-size:21rpx; line-height:1.45; }
.file-stats { margin-top:16rpx; color:#526782; font-size:22rpx; }
.rename-button { flex-shrink:0; margin:0; padding:4rpx 12rpx; color:#526782; background:rgba(224,232,246,.72); font-size:20rpx; line-height:1.6; }
.rename-mask { position:fixed; z-index:40; top:0; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:center; padding:32rpx; box-sizing:border-box; background:rgba(31,42,68,.38); }
.rename-dialog { width:100%; box-sizing:border-box; padding:28rpx; border-radius:20rpx; background:#f8fbff; }
.rename-title { color:#263957; font-size:30rpx; font-weight:700; }
.rename-input { margin-top:22rpx; padding:18rpx; border:1rpx solid rgba(123,148,184,.42); border-radius:12rpx; color:#263957; background:#fff; font-size:25rpx; }
.rename-actions { display:flex; gap:16rpx; margin-top:24rpx; }
.rename-actions button { flex:1; margin:0; font-size:24rpx; }
