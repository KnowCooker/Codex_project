.top { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:22rpx; }.notice { margin-bottom:18rpx; }.error { color:#a74358; background:rgba(255,220,226,.74); }.chart-card { width:100%; box-sizing:border-box; overflow:hidden; background:rgba(255,255,255,.68); border:2rpx solid rgba(133,157,191,.42); box-shadow:none; border-radius:18rpx; padding:18rpx; margin-bottom:18rpx; }.chart-label { font-size:22rpx; color:#66758d; margin:0 0 6rpx 4rpx; }.chart-note { color:#8a7656; font-size:19rpx; line-height:1.4; margin-left:4rpx; }.chart-shell { width:100%; box-sizing:border-box; margin-top:12rpx; padding:5rpx; overflow:hidden; background:#edf3fa; border:2rpx solid #9eb2ca; border-radius:10rpx; box-shadow:none; }.chart { width:100%; min-width:0; display:block; }.spectrum-chart { max-width:100%; border:1rpx solid rgba(104,126,156,.55); border-radius:5rpx; box-sizing:border-box; }.axis-caption { display:flex; flex-wrap:wrap; gap:8rpx 18rpx; justify-content:space-between; color:#718096; font-size:18rpx; margin:8rpx 4rpx 16rpx; }.scale-controls { display:flex; flex-wrap:wrap; gap:10rpx; align-items:center; }.scale-button { margin:0; padding:9rpx 16rpx; background:rgba(232,239,250,.78); color:#526782; font-size:21rpx; line-height:1.35; }.scale-button.active { color:#087f78; outline:1rpx solid #45bdb5; background:rgba(196,247,237,.72); }.range-inputs { width:100%; display:flex; align-items:center; gap:10rpx; margin-top:4rpx; color:#718096; font-size:21rpx; }.range-inputs input { flex:1; min-width:0; padding:12rpx; border:1rpx solid rgba(123,148,184,.35); border-radius:10rpx; background:rgba(255,255,255,.70); color:#334563; text-align:center; }.range-inputs button { margin:0; padding:12rpx 18rpx; background:#38b6ad; color:#fff; font-size:21rpx; }.controls { display:flex; gap:18rpx; margin-top:24rpx; }.controls button { flex:1; font-size:26rpx; }.control-button { border-radius:16rpx; font-size:26rpx; font-weight:650; transition:background-color .16s ease,color .16s ease,transform .12s ease; }.pause-button { color:#8a5a00; background:rgba(255,224,153,.82); }.resume-button { color:#fff; background:#32aaa2; box-shadow:0 8rpx 18rpx rgba(37,169,157,.20); }.control-button:active { transform:scale(.98); }.record { font-size:26rpx; }.stop-analysis { margin-top:16rpx; font-size:26rpx; }.unit { font-size:20rpx; font-weight:400; color:#718096; }.spectrum-heading { display:flex; flex-wrap:wrap; align-items:flex-start; justify-content:space-between; gap:10rpx; }.axis-switch { display:flex; flex-shrink:0; gap:6rpx; }.axis-button { min-width:76rpx; margin:0; padding:6rpx 10rpx; color:#526782; background:rgba(232,239,250,.78); font-size:20rpx; line-height:1.4; }.axis-button.active { color:#087f78; outline:1rpx solid #45bdb5; background:rgba(196,247,237,.72); }
.spectrum-legend { display:flex; flex-wrap:wrap; gap:8rpx 16rpx; align-items:center; margin:10rpx 4rpx 4rpx; color:#718096; font-size:17rpx; line-height:1.5; }
.spectrum-legend view { display:flex; align-items:center; white-space:nowrap; }
.line-swatch { width:30rpx; height:0; margin-right:6rpx; border-top:4rpx solid #6772dc; }
.reference-line { border-top-color:#e28a43; border-top-style:dashed; }
.band-swatch { width:18rpx; height:12rpx; margin-right:6rpx; border-radius:3rpx; }
.band-low { background:rgba(88,156,235,.35); }
.band-mid { background:rgba(65,184,139,.32); }
.band-high { background:rgba(241,164,74,.35); }
.reference-button, .file-reference-button, .clear-reference { margin:0; padding:9rpx 16rpx; font-size:21rpx; line-height:1.35; }
.reference-button { color:#9a5a24; background:rgba(255,231,204,.82); outline:1rpx solid rgba(226,138,67,.55); }
.file-reference-button { color:#425e8b; background:rgba(220,233,253,.86); outline:1rpx solid rgba(94,126,180,.38); }
.clear-reference { color:#718096; background:rgba(237,241,247,.78); }
.chart-switches { display:flex; flex-direction:column; gap:8rpx; flex-shrink:0; }
.switch-row { display:flex; align-items:center; justify-content:flex-end; gap:6rpx; color:#718096; font-size:18rpx; }
.switch-row .axis-button { min-width:68rpx; }
.metric-section-label { margin:4rpx 4rpx 12rpx; color:#526782; font-size:22rpx; font-weight:600; }
.reference-metrics { margin-top:22rpx; padding:16rpx; border-radius:18rpx; background:rgba(255,240,221,.42); border:1rpx solid rgba(226,138,67,.22); }
.reference-title { color:#9a5a24; }
.reference-metric { background:rgba(255,250,244,.62); border-color:rgba(255,236,214,.9); }
.recording-status { margin:0 0 18rpx; padding:16rpx 18rpx; color:#963c50; background:linear-gradient(135deg,rgba(255,239,242,.92),rgba(255,221,228,.76)); border:2rpx solid rgba(196,75,99,.34); border-radius:14rpx; box-shadow:inset 0 2rpx 0 rgba(255,255,255,.85),0 8rpx 18rpx rgba(151,60,79,.12); }
.recording-status.finalizing { color:#7b6381; background:linear-gradient(135deg,rgba(247,241,252,.94),rgba(233,224,244,.78)); border-color:rgba(123,99,129,.32); }
.recording-status-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.recording-title { display:flex; align-items:center; font-size:24rpx; font-weight:650; }
.recording-dot { width:13rpx; height:13rpx; margin-right:10rpx; border-radius:50%; background:#cf4f68; box-shadow:0 0 0 5rpx rgba(207,79,104,.13); }
.finalizing .recording-dot { background:#8e74a0; box-shadow:0 0 0 5rpx rgba(142,116,160,.13); }
.recording-time { font-size:25rpx; font-variant-numeric:tabular-nums; font-weight:700; }
.recording-progress { height:8rpx; margin-top:13rpx; overflow:hidden; border-radius:99rpx; background:rgba(126,70,82,.13); }
.recording-progress-value { height:100%; border-radius:99rpx; background:linear-gradient(90deg,#e16d82,#be3f5a); transition:width .18s linear; }
.modal-mask { position:fixed; z-index:30; top:0; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:center; padding:30rpx; box-sizing:border-box; background:rgba(31,42,68,.38); }
.reference-dialog { width:100%; max-height:78vh; box-sizing:border-box; padding:26rpx; border:2rpx solid rgba(132,152,181,.55); border-radius:20rpx; background:#f8fbff; }
.dialog-title { color:#263957; font-size:30rpx; font-weight:700; }
.dialog-subtitle { margin-top:10rpx; color:#718096; font-size:21rpx; line-height:1.5; }
.recording-picker-list { max-height:48vh; margin-top:20rpx; }
.recording-picker-item { padding:18rpx; margin-bottom:12rpx; border:1rpx solid rgba(123,148,184,.34); border-radius:12rpx; background:#fff; }
.recording-picker-item:active { background:#edf5ff; }
.picker-file-title { color:#314766; font-size:25rpx; font-weight:650; }
.picker-file-meta { margin-top:8rpx; color:#718096; font-size:20rpx; line-height:1.4; }
.import-progress { display:flex; justify-content:space-between; margin-top:18rpx; color:#526782; font-size:21rpx; }
.import-progress-track { height:8rpx; margin-top:8rpx; overflow:hidden; border-radius:99rpx; background:#dde7f4; }
.import-progress-track view { height:100%; background:#6772dc; }
.import-error { margin-top:16rpx; margin-bottom:0; }
.dialog-close { margin-top:18rpx; font-size:24rpx; }
.drawing-settings-toggle { width:100%; margin:4rpx 0 0; color:#38516f; background:rgba(224,232,246,.78); font-size:23rpx; line-height:1.8; }
.drawing-settings { margin-top:12rpx; padding:16rpx; border-radius:14rpx; background:rgba(237,243,250,.72); border:1rpx solid rgba(123,148,184,.26); }
.setting-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:14rpx; }
.setting-label { color:#526782; font-size:22rpx; }
.setting-hint { margin-top:5rpx; color:#8492a7; font-size:18rpx; }
.calibration-label { margin-top:18rpx; }
.calibration-input { margin-top:8rpx; }
.frequency-range-inputs { margin-bottom:14rpx; }
.setting-options { display:flex; flex-shrink:0; gap:8rpx; }
.setting-options .axis-button { min-width:72rpx; }
.average-setting { display:block; }
.average-slider { margin:8rpx 0 0; }
.reference-controls { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:16rpx; }
@media (max-width: 360px) {
  .metric-label { font-size:19rpx; }
  .metric-value { font-size:28rpx; }
  .chart-switches { width:100%; flex-direction:row; justify-content:space-between; }
}
