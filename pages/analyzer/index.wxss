.top { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:22rpx; }.notice { margin-bottom:18rpx; }.error { color:#a74358; background:rgba(255,220,226,.74); }.chart-card { background:rgba(255,255,255,.62); border:1rpx solid rgba(255,255,255,.9); box-shadow:0 12rpx 32rpx rgba(76,101,141,.08); border-radius:18rpx; padding:18rpx; margin-bottom:18rpx; }.chart-label { font-size:22rpx; color:#66758d; margin:0 0 12rpx 4rpx; }.chart { width:694rpx; height:260rpx; display:block; }.controls { display:flex; gap:18rpx; margin-top:24rpx; }.controls button { flex:1; }.unit { font-size:20rpx; font-weight:400; color:#718096; }.spectrum-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:10rpx; }.axis-switch { display:flex; gap:6rpx; }.axis-button { min-width:76rpx; margin:0; padding:6rpx 10rpx; color:#526782; background:rgba(232,239,250,.78); font-size:20rpx; line-height:1.4; }.axis-button.active { color:#087f78; outline:1rpx solid #45bdb5; background:rgba(196,247,237,.72); }
