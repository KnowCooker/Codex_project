.top { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:22rpx; }.notice { margin-bottom:18rpx; }.error { color:#a74358; background:rgba(255,220,226,.74); }.chart-card { width:100%; box-sizing:border-box; overflow:hidden; background:rgba(255,255,255,.62); border:1rpx solid rgba(255,255,255,.9); box-shadow:0 12rpx 32rpx rgba(76,101,141,.08); border-radius:18rpx; padding:18rpx; margin-bottom:18rpx; }.chart-label { font-size:22rpx; color:#66758d; margin:0 0 6rpx 4rpx; }.chart-note { color:#8a7656; font-size:19rpx; line-height:1.4; margin-left:4rpx; }.chart { width:100%; min-width:0; display:block; }.spectrum-chart { max-width:100%; }.axis-caption { display:flex; flex-wrap:wrap; gap:8rpx 18rpx; justify-content:space-between; color:#718096; font-size:18rpx; margin:8rpx 4rpx 16rpx; }.scale-controls { display:flex; flex-wrap:wrap; gap:10rpx; align-items:center; }.scale-button { margin:0; padding:9rpx 16rpx; background:rgba(232,239,250,.78); color:#526782; font-size:21rpx; line-height:1.35; }.scale-button.active { color:#087f78; outline:1rpx solid #45bdb5; background:rgba(196,247,237,.72); }.range-inputs { width:100%; display:flex; align-items:center; gap:10rpx; margin-top:4rpx; color:#718096; font-size:21rpx; }.range-inputs input { flex:1; min-width:0; padding:12rpx; border:1rpx solid rgba(123,148,184,.35); border-radius:10rpx; background:rgba(255,255,255,.70); color:#334563; text-align:center; }.range-inputs button { margin:0; padding:12rpx 18rpx; background:#38b6ad; color:#fff; font-size:21rpx; }.controls { display:flex; gap:18rpx; margin-top:24rpx; }.controls button { flex:1; }.control-button { border-radius:16rpx; font-size:26rpx; font-weight:650; transition:background-color .16s ease,color .16s ease,transform .12s ease; }.pause-button { color:#8a5a00; background:rgba(255,224,153,.82); }.resume-button { color:#fff; background:#32aaa2; box-shadow:0 8rpx 18rpx rgba(37,169,157,.20); }.control-button:active { transform:scale(.98); }.record { font-size:26rpx; }.stop-analysis { margin-top:16rpx; font-size:25rpx; }.unit { font-size:20rpx; font-weight:400; color:#718096; }.spectrum-heading { display:flex; flex-wrap:wrap; align-items:flex-start; justify-content:space-between; gap:10rpx; }.axis-switch { display:flex; flex-shrink:0; gap:6rpx; }.axis-button { min-width:76rpx; margin:0; padding:6rpx 10rpx; color:#526782; background:rgba(232,239,250,.78); font-size:20rpx; line-height:1.4; }.axis-button.active { color:#087f78; outline:1rpx solid #45bdb5; background:rgba(196,247,237,.72); }
.spectrum-legend { display:flex; flex-wrap:wrap; gap:8rpx 16rpx; align-items:center; margin:10rpx 4rpx 4rpx; color:#718096; font-size:17rpx; line-height:1.5; }
.spectrum-legend view { display:flex; align-items:center; white-space:nowrap; }
.line-swatch { width:30rpx; height:0; margin-right:6rpx; border-top:4rpx solid #6772dc; }
.reference-line { border-top-color:#e28a43; border-top-style:dashed; }
.band-swatch { width:18rpx; height:12rpx; margin-right:6rpx; border-radius:3rpx; }
.band-low { background:rgba(88,156,235,.35); }
.band-mid { background:rgba(65,184,139,.32); }
.band-high { background:rgba(241,164,74,.35); }
.reference-button, .clear-reference { margin:0; padding:9rpx 16rpx; font-size:21rpx; line-height:1.35; }
.reference-button { color:#9a5a24; background:rgba(255,231,204,.82); outline:1rpx solid rgba(226,138,67,.55); }
.clear-reference { color:#718096; background:rgba(237,241,247,.78); }
