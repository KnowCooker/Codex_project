<view class="page">
  <view class="top">
    <view>
      <view class="title">{{mode === 'phone' ? '手机麦克风' : '耳机麦克风'}}</view>
      <view class="subtitle">{{source}} · 分析 {{elapsed}} · {{earSide === 'auto' ? '自动耳侧' : '用户声明' + (earSide === 'left' ? '左耳' : '右耳')}}</view>
    </view>
    <text class="tag {{recording ? 'warn' : (state === 'analysing' ? 'ok' : 'warn')}}">{{recording ? '录音 ' + recordingElapsed + '/00:30.0' : (state === 'analysing' ? '分析中' : (state === 'paused' ? '已暂停' : '准备中'))}}</text>
  </view>
  <view wx:if="{{warning}}" class="notice">{{warning}}</view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view wx:if="{{recording}}" class="recording-status {{recordingFinalizing ? 'finalizing' : ''}}">
    <view class="recording-status-row"><view class="recording-title"><text class="recording-dot"></text>{{recordingFinalizing ? '正在生成 WAV 文件' : '正在录音'}}</view><text class="recording-time">{{recordingElapsed}} / 00:30.0</text></view>
    <view class="recording-progress"><view class="recording-progress-value" style="width: {{recordingProgress}}%;"></view></view>
  </view>

  <view class="chart-card">
    <view class="spectrum-heading"><view><view class="chart-label">平均频谱 · 20–500 Hz · 过去 {{averageSeconds}} 秒 · {{weightingLabel}}</view><view class="chart-note">0.98 Hz/bin · 有效分辨率约 1.95 Hz · 512 ms 数据窗；频谱与指标均按功率平均，声压级未经设备校准。</view></view></view>
    <view class="chart-shell" hidden="{{referencePickerOpen}}"><canvas id="spectrumCanvas" canvas-id="spectrum" class="chart spectrum-chart" width="{{canvasWidth}}" height="{{canvasHeight}}" style="height: {{canvasCssHeight}}px;"></canvas></view>
    <view class="spectrum-legend">
      <view><text class="line-swatch live-line"></text>{{averageSeconds}} 秒平均频谱</view>
      <view wx:if="{{hasReference}}"><text class="line-swatch reference-line"></text>参考 {{referenceTime}}</view>
      <view><text class="band-swatch band-low"></text>20–60 Hz</view>
      <view><text class="band-swatch band-mid"></text>70–150 Hz</view>
      <view><text class="band-swatch band-high"></text>160–240 Hz</view>
    </view>
    <view class="axis-caption"><text>纵轴：估计声压级 / {{weightingUnit}}</text><text>横轴：频率 / Hz</text></view>
    <button class="drawing-settings-toggle" bindtap="toggleSettings">{{settingsOpen ? '收起绘图设置' : '绘图设置'}}</button>
    <view wx:if="{{settingsOpen}}" class="drawing-settings">
      <view class="setting-row"><text class="setting-label">计权</text><view class="setting-options"><button data-weighting="a" bindtap="setWeighting" class="axis-button {{weighting === 'a' ? 'active' : ''}}">A</button><button data-weighting="linear" bindtap="setWeighting" class="axis-button {{weighting === 'linear' ? 'active' : ''}}">线性</button></view></view>
      <view class="setting-row average-setting"><view><view class="setting-label">平均时长：{{averageSeconds}} 秒</view><view class="setting-hint">可调范围 1–30 秒，窗口越长曲线越稳定</view></view><slider class="average-slider" min="1" max="30" step="1" value="{{averageSeconds}}" bindchange="setAverageDuration" activeColor="#38b6ad" backgroundColor="#dfe8f4" block-size="18"/></view>
      <view class="setting-row"><text class="setting-label">横轴</text><view class="setting-options"><button data-axis="log" bindtap="setSpectrumAxis" class="axis-button {{spectrumAxis === 'log' ? 'active' : ''}}">对数</button><button data-axis="linear" bindtap="setSpectrumAxis" class="axis-button {{spectrumAxis === 'linear' ? 'active' : ''}}">线性</button></view></view>
      <view class="setting-row"><text class="setting-label">纵轴</text><view class="setting-options"><button data-mode="auto" bindtap="setYScaleMode" class="scale-button {{yScaleMode === 'auto' ? 'active' : ''}}">自动</button><button data-mode="manual" bindtap="setYScaleMode" class="scale-button {{yScaleMode === 'manual' ? 'active' : ''}}">固定</button></view></view>
      <view wx:if="{{yScaleMode === 'manual'}}" class="range-inputs"><input type="text" value="{{manualMin}}" bindinput="setManualMin" placeholder="最小 {{weightingUnit}}"/><text>至</text><input type="text" value="{{manualMax}}" bindinput="setManualMax" placeholder="最大 {{weightingUnit}}"/><button bindtap="applyManualRange">应用</button></view>
      <view class="reference-controls"><button class="reference-button" disabled="{{!hasData}}" bindtap="setReference">{{hasReference ? '更新参考' : '设为参考'}}</button><button class="file-reference-button" disabled="{{recording}}" bindtap="openReferencePicker">从录音导入</button><button wx:if="{{hasReference}}" class="clear-reference" bindtap="clearReference">清除参考</button></view>
    </view>
  </view>

  <view class="metric-section-label">过去 {{averageSeconds}} 秒平均指标 · {{weightingLabel}}</view>
  <view class="grid">
    <view class="metric"><view class="metric-label">总声压级</view><view class="metric-value">{{metricView ? metricView.total : '--'}} <text class="unit">{{weightingUnit}}</text></view></view>
    <view class="metric"><view class="metric-label">低频峰值 · 20–60 Hz</view><view class="metric-value">{{metricView ? metricView.low : '--'}} <text class="unit">{{weightingUnit}}</text></view></view>
    <view class="metric"><view class="metric-label">中频峰值 · 70–150 Hz</view><view class="metric-value">{{metricView ? metricView.mid : '--'}} <text class="unit">{{weightingUnit}}</text></view></view>
    <view class="metric"><view class="metric-label">空腔声峰值 · 160–240 Hz</view><view class="metric-value">{{metricView ? metricView.high : '--'}} <text class="unit">{{weightingUnit}}</text></view></view>
  </view>

  <view wx:if="{{hasReference}}" class="reference-metrics">
    <view class="metric-section-label reference-title">参考指标 · {{referenceTime}} · {{weightingLabel}}</view>
    <view class="grid">
      <view class="metric reference-metric"><view class="metric-label">总声压级</view><view class="metric-value">{{referenceMetricView.total}} <text class="unit">{{weightingUnit}}</text></view></view>
      <view class="metric reference-metric"><view class="metric-label">低频峰值 · 20–60 Hz</view><view class="metric-value">{{referenceMetricView.low}} <text class="unit">{{weightingUnit}}</text></view></view>
      <view class="metric reference-metric"><view class="metric-label">中频峰值 · 70–150 Hz</view><view class="metric-value">{{referenceMetricView.mid}} <text class="unit">{{weightingUnit}}</text></view></view>
      <view class="metric reference-metric"><view class="metric-label">空腔声峰值 · 160–240 Hz</view><view class="metric-value">{{referenceMetricView.high}} <text class="unit">{{weightingUnit}}</text></view></view>
    </view>
  </view>

  <view class="controls">
    <button class="control-button {{state === 'paused' ? 'resume-button' : 'pause-button'}}" disabled="{{state !== 'analysing' && state !== 'paused'}}" bindtap="togglePause">{{state === 'paused' ? '继续分析' : '暂停分析'}}</button>
    <button wx:if="{{!recording}}" class="primary record" disabled="{{state !== 'analysing'}}" bindtap="startRecording">开始录音</button>
    <button wx:else class="danger record" bindtap="stopRecording">结束录音</button>
  </view>
  <button class="secondary stop-analysis" bindtap="stopAnalysis">结束分析（不保存录音）</button>

  <view wx:if="{{referencePickerOpen}}" class="modal-mask" bindtap="closeReferencePicker" catchtouchmove="keepReferencePickerOpen">
    <view class="reference-dialog" catchtap="keepReferencePickerOpen">
      <view class="dialog-title">选择录音文件</view>
      <view class="dialog-subtitle">选择后将读取整个 WAV，按 512 ms 窗和 50% 重叠计算功率平均频谱。</view>
      <view wx:if="{{referenceLoading}}" class="import-progress"><text>正在计算平均 FFT</text><text>{{referenceProgress}}%</text></view>
      <view wx:if="{{referenceLoading}}" class="import-progress-track"><view style="width: {{referenceProgress}}%;"></view></view>
      <view wx:if="{{referenceImportError}}" class="notice error import-error">{{referenceImportError}}</view>
      <scroll-view scroll-y class="recording-picker-list">
        <view wx:for="{{recordings}}" wx:key="id" class="recording-picker-item" data-id="{{item.id}}" bindtap="selectReferenceFile">
          <view class="picker-file-title">{{item.name}}</view>
          <view class="picker-file-meta">{{item.createdAt}} · {{item.durationLabel}} · {{item.fileSizeLabel}} · {{item.mode === 'phone' ? '手机' : '耳机'}}</view>
        </view>
      </scroll-view>
      <button class="secondary dialog-close" disabled="{{referenceLoading}}" bindtap="closeReferencePicker">取消</button>
    </view>
  </view>
</view>
