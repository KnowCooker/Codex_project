<view class="page"><view class="top"><view><view class="title">{{mode === 'phone' ? '手机麦克风' : '耳机麦克风'}}</view><view class="subtitle">{{source}} · 分析 {{elapsed}} · {{earSide === 'auto' ? '自动耳侧' : '用户声明' + (earSide === 'left' ? '左耳' : '右耳')}}</view></view><text class="tag {{recording ? 'warn' : (state === 'analysing' ? 'ok' : 'warn')}}">{{recording ? '录音 ' + recordingElapsed + '/00:30' : (state === 'analysing' ? '分析中' : (state === 'paused' ? '已暂停' : '准备中'))}}</text></view>
<view wx:if="{{warning}}" class="notice">{{warning}}</view><view wx:if="{{error}}" class="notice error">{{error}}</view>
<view class="chart-card"><view class="spectrum-heading"><view><view class="chart-label">频谱 · 20–500 Hz · 约 0.98 Hz/bin · 纵轴自动缩放</view><view class="chart-note">估计声压级为未校准相对 dB，不作为专业 SPL 读数。</view></view><view class="axis-switch"><button data-axis="log" bindtap="setSpectrumAxis" class="axis-button {{spectrumAxis === 'log' ? 'active' : ''}}">对数</button><button data-axis="linear" bindtap="setSpectrumAxis" class="axis-button {{spectrumAxis === 'linear' ? 'active' : ''}}">线性</button></view></view><canvas canvas-id="spectrum" class="chart" width="694" height="260"></canvas></view>
<view class="grid"><view class="metric"><view class="metric-label">RMS</view><view class="metric-value">{{metricView ? metricView.rms : '--'}} <text class="unit">dBFS</text></view></view><view class="metric"><view class="metric-label">数字峰值</view><view class="metric-value">{{metricView ? metricView.peak : '--'}} <text class="unit">dBFS</text></view></view><view class="metric"><view class="metric-label">主峰频率</view><view class="metric-value">{{metricView ? metricView.frequency : '--'}} <text class="unit">Hz</text></view></view><view class="metric"><view class="metric-label">削波帧</view><view class="metric-value">{{metricView ? metricView.clipped : '--'}}</view></view></view>
<view class="controls"><button class="secondary" bindtap="togglePause">{{state === 'paused' ? '继续' : '暂停'}}</button><button wx:if="{{!recording}}" class="primary record" bindtap="startRecording">开始录音</button><button wx:else class="danger" bindtap="stopRecording">结束录音</button></view><button class="secondary stop-analysis" bindtap="stopAnalysis">结束分析（不保存录音）</button></view>
