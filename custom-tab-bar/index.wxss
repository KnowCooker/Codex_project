.tab-bar { position:fixed; z-index:1000; right:0; bottom:0; left:0; height:104rpx; display:flex; align-items:stretch; padding-bottom:env(safe-area-inset-bottom); border-top:1rpx solid rgba(126,149,181,.22); background:#f8fbff; box-shadow:0 -8rpx 24rpx rgba(76,101,141,.08); }
.tab-item { flex:1; display:flex; align-items:center; justify-content:center; color:#66758d; font-size:28rpx; line-height:104rpx; text-align:center; }
.tab-item.selected { color:#087f78; font-weight:700; background:rgba(196,247,237,.24); }
