page { background: linear-gradient(150deg, #f0f7ff 0%, #f7f3ff 48%, #edfffc 100%); color: #1f2a44; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { min-height: 100vh; padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: linear-gradient(150deg, #f0f7ff 0%, #f7f3ff 48%, #edfffc 100%); }
.card { background: rgba(255, 255, 255, .66); border: 1rpx solid rgba(255, 255, 255, .88); box-shadow: 0 12rpx 32rpx rgba(76, 101, 141, .10); border-radius: 20rpx; padding: 28rpx; margin-bottom: 22rpx; }
.title { font-size: 36rpx; font-weight: 700; color: #1f2a44; }
.subtitle { color: #66758d; font-size: 25rpx; margin-top: 10rpx; line-height: 1.5; }
.section-title { color: #344563; font-size: 27rpx; font-weight: 600; margin-bottom: 22rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.muted { color: #718096; font-size: 24rpx; }
.value { color: #263957; font-size: 26rpx; text-align: right; }
.tag { display: inline-block; padding: 6rpx 14rpx; border-radius: 99rpx; background: rgba(228, 237, 255, .70); color: #526782; font-size: 22rpx; }
.tag.ok { color: #087f78; background: rgba(116, 222, 205, .26); }
.tag.warn { color: #9b6a08; background: rgba(253, 208, 113, .30); }
.primary { background: #38b6ad; color: #fff; box-shadow: 0 8rpx 18rpx rgba(37,169,157,.20); font-size: 30rpx; font-weight: 700; border-radius: 16rpx; }
.primary[disabled] { opacity: .45; }
.secondary { background: rgba(224, 232, 246, .78); color: #38516f; border-radius: 16rpx; }
.danger { background: rgba(255, 220, 226, .82); color: #a74358; border-radius: 16rpx; }
button::after { border: 0; }
.divider { height: 1rpx; background: rgba(126, 149, 181, .18); margin: 22rpx 0; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.metric { background: rgba(255, 255, 255, .55); border: 1rpx solid rgba(255, 255, 255, .82); border-radius: 14rpx; padding: 18rpx; }
.metric-label { color: #718096; font-size: 22rpx; }
.metric-value { color: #243651; font-size: 32rpx; font-weight: 650; margin-top: 8rpx; }
.notice { padding: 18rpx; border-radius: 12rpx; background: rgba(255, 236, 181, .56); color: #85600a; font-size: 24rpx; line-height: 1.5; }
.empty { color: #718096; font-size: 27rpx; text-align: center; padding: 80rpx 10rpx; }
